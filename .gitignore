# Python environments and generated bytecode.
.venv/
__pycache__/
*.py[cod]

# Test, type-checking, linting, and coverage artifacts.
.coverage
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Build artifacts.
build/
dist/
target/
*.egg-info/

# Internal design records remain available locally but are not published.
/docs/architecture.md
/docs/context-memory-refactor.md
/docs/tui-design.md

# Local runtime state. Runtime data must never be committed.
.pleiad-workspace/
.env
!.env.example
workspace/runtime/logs/*
!workspace/runtime/logs/.gitkeep
workspace/runtime/memory/*
!workspace/runtime/memory/.gitkeep
workspace/runtime/artifacts/*
!workspace/runtime/artifacts/.gitkeep
workspace/runtime/executions/*
!workspace/runtime/executions/.gitkeep
workspace/runtime/graphs/*
!workspace/runtime/graphs/.gitkeep
workspace/runtime/graph-runs/*
!workspace/runtime/graph-runs/.gitkeep
workspace/runtime/node-runs/*
!workspace/runtime/node-runs/.gitkeep
workspace/runtime/traces/*
!workspace/runtime/traces/.gitkeep

# Editor and operating-system metadata.
.DS_Store
.idea/
.vscode/

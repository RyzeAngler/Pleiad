[importlinter]
root_packages =
    pleiad
    pleiad_weave

[importlinter:framework_does_not_import_application]
name = Pleiad framework has no product dependency
type = forbidden
source_modules =
    pleiad
forbidden_modules =
    pleiad_weave

[importlinter:weave_does_not_access_sdk_internals]
name = Weave uses only the public Pleiad API
type = forbidden
source_modules =
    pleiad_weave
forbidden_modules =
    pleiad.runtime.execution.loop
    pleiad.runtime.execution.model_input
    pleiad.runtime.execution.control
allow_indirect_imports = true

[importlinter:weave_uses_runner]
name = Weave does not bypass the Pleiad Runner
type = forbidden
source_modules =
    pleiad_weave
forbidden_modules =
    pleiad.runtime.execution.loop
allow_indirect_imports = true

[importlinter:models_is_boundary]
name = Model adapters stay below orchestration
type = forbidden
source_modules =
    pleiad.models
forbidden_modules =
    pleiad.tools
    pleiad.skills
    pleiad.memory
    pleiad.agent
    pleiad.orchestration
    pleiad.runtime
    pleiad_weave.application
    pleiad_weave.api

[importlinter:tools_is_standalone]
name = Tools stay independent from orchestration
type = forbidden
source_modules =
    pleiad.tools
forbidden_modules =
    pleiad.skills
    pleiad.memory
    pleiad.agent
    pleiad.orchestration
    pleiad.runtime
    pleiad_weave.application
    pleiad_weave.api

[importlinter:skills_are_prompt_assets]
name = Skills stay independent from execution
type = forbidden
source_modules =
    pleiad.skills
forbidden_modules =
    pleiad.tools
    pleiad.memory
    pleiad.agent
    pleiad.orchestration
    pleiad.runtime
    pleiad_weave.application
    pleiad_weave.api

[importlinter:memory_is_standalone]
name = Memory stays independent from execution
type = forbidden
source_modules =
    pleiad.memory
forbidden_modules =
    pleiad.agent
    pleiad.orchestration
    pleiad.runtime
    pleiad_weave.application
    pleiad_weave.api

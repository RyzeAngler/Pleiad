Screen { background: #101318; color: #e7e9ee; }
#heading { height: 3; padding: 1 2; color: #7db7ff; text-style: bold; }
#workspace { height: 1fr; }
#chat-pane { width: 55%; padding: 0 1; }
#details-pane { width: 45%; border-left: solid #39414e; padding: 0 1; }
#chat { height: 1fr; border: solid #39414e; padding: 1; }
#composer-target { height: auto; max-height: 3; padding-top: 1; color: #b3bfd1; }
#composer-input { margin-top: 1; }
#categories { height: 3; }
#categories Button { min-width: 10; width: 1fr; }
#entities { height: 8; border-bottom: solid #39414e; }
#detail { height: 1fr; padding: 1 0; }
.actions { height: 3; }
.actions Button { min-width: 7; width: 1fr; }
#older { height: 3; width: auto; }
#connection-status { height: 2; padding: 0 2; color: #b3bfd1; }
Button { background: #202731; border: none; }
Button:focus { background: #294d79; }
Button:disabled { color: #66717e; background: #161c24; }
Input:focus { border: tall #7db7ff; }
ListItem { height: auto; padding: 0 1; }

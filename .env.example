# Pleiad 应用配置。
# 模型是全局配置；能力 YAML 保存元数据，mcp.json 保存连接配置与环境变量名。
PLEIAD_LLM_PROTOCOL=openai
PLEIAD_LLM_PROVIDER=deepseek
PLEIAD_LLM_MODEL=deepseek-v4-flash
PLEIAD_LLM_API_KEY=
PLEIAD_LLM_BASE_URL=
PLEIAD_LLM_TIMEOUT_SECONDS=120
PLEIAD_LLM_MAX_RETRIES=2

# MCP presets are disabled in the host mcp.json until explicitly enabled.
# PLEIAD_MCP_CONFIG_FILE=/absolute/path/outside/workspace/mcp.json
# Store values here or export them in the Weave host process.
# FIRECRAWL_API_KEY=
# CONTEXT7_API_KEY=
# GITHUB_TOKEN=
# ACTIVEPIECES_MCP_URL=
# AMAP_MCP_URL=https://mcp.amap.com/mcp?key=YOUR_AMAP_KEY
# BAIDU_MAPS_MCP_URL=https://mcp.map.baidu.com/mcp?ak=YOUR_BAIDU_AK
# TUNIU_API_KEY=
# OAuth tokens stay outside the tool-visible workspace; this path is gitignored.
# PLEIAD_MCP_AUTH_DIRECTORY=.pleiad-workspace/mcp

# Optional host-enforced approval for loaded workspace Tools; use their exact codes.
# PLEIAD_APPROVAL_TOOL_CODES=["command"]

# 主 Agent 记忆配置。
# 默认用户标识仅用于内部存储，不代表产品层面的用户模型。
PLEIAD_MEMORY_USER_ID=default-user
PLEIAD_MEMORY_CROSS_SPACE=false
PLEIAD_MEMORY_RECALL_MAX_RESULTS=5

# 可选的视觉和语音模型。
# PLEIAD_LLM_VISION_MODEL=
# PLEIAD_LLM_VISION_BASE_URL=
# PLEIAD_LLM_SPEECH_MODEL=
# PLEIAD_LLM_SPEECH_BASE_URL=

# 默认使用仓库中的 workspace/ 目录。
# 运行数据使用 workspace/runtime-v2/；旧 runtime/ 保留且不会自动迁移。
# PLEIAD_WORKSPACE=/absolute/path/to/another-workspace
# PLEIAD_CAPABILITY_FILE=/absolute/path/to/capabilities.yaml

# Optional host-owned read-only directory source. Unset or blank keeps it disabled.
# Explicit observation records metadata and digests without creating Executions.
# PLEIAD_OBSERVE_DIRECTORY=/absolute/path/to/observed-directory
# PLEIAD_OBSERVE_MAX_FILES=1000
# PLEIAD_OBSERVE_MAX_FILE_BYTES=26214400
# PLEIAD_OBSERVE_MAX_TOTAL_BYTES=104857600

PLEIAD_LOG_LEVEL=INFO
PLEIAD_LOG_CONSOLE=true

# Workspace Python Tools, Bash, and Skill scripts use the OCI sandbox backend.
PLEIAD_SANDBOX_RUNTIME=docker
# Set a real, locally installed name@sha256:<64 hex digits> reference.
PLEIAD_SANDBOX_IMAGE=

PLEIAD_LOG_MAX_FILE_BYTES=31457280
PLEIAD_LOG_BACKUP_COUNT=7
